<?xml version="1.0" encoding="UTF-8"?>
<project name="CRUD-AETP" default="jar" basedir=".">
    <description>Builds, tests, and packages the CRUD AETP project.</description>

    <property name="src.dir" value="src"/>
    <property name="test.src.dir" value="test"/>
    <property name="build.dir" value="build"/>
    <property name="classes.dir" value="${build.dir}/classes"/>
    <property name="dist.dir" value="dist"/>
    <property name="dist.jar" value="${dist.dir}/CRUD-AETP.jar"/>
    <property name="main.class" value="aetp.taller.AETPTaller"/>

    <target name="clean">
        <delete dir="${build.dir}"/>
        <delete dir="${dist.dir}"/>
    </target>

    <target name="compile">
        <mkdir dir="${classes.dir}"/>
        <javac srcdir="${src.dir}" destdir="${classes.dir}" includeantruntime="false" encoding="UTF-8" source="25" target="25"/>
    </target>

    <target name="jar" depends="clean,compile">
        <mkdir dir="${dist.dir}"/>
        <jar destfile="${dist.jar}" basedir="${classes.dir}">
            <manifest>
                <attribute name="Main-Class" value="${main.class}"/>
            </manifest>
        </jar>
    </target>

    <target name="run" depends="jar">
        <java jar="${dist.jar}" fork="true"/>
    </target>

    <target name="test" depends="compile">
        <java classname="aetp.taller.InventorySmokeTest" fork="false" failonerror="true">
            <classpath>
                <pathelement location="${classes.dir}"/>
            </classpath>
        </java>
    </target>
</project>
